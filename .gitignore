# ProCoder Standard Gitignore

# Elixir / Erlang
/_build/
/deps/
/*.ez
# Note: mix.lock is committed for reproducible builds
erl_crash.dump
/doc/
/cover/

# ProCoder Internal State (Agent Caching & History)
/.procoder/
.procoder/session_logs/
/.cdms_model/
/.archives/
/.shadow/
.shadow/
/workspaces/
/reports/

# Scratch & Staging
scratch/
/scratch/

# Databases (SQLite)
*.db
*.db-shm
*.db-wal
/priv/repo/*.db
/priv/repo/*.db-shm
/priv/repo/*.db-wal

# Hardened Secrets & Environment
.env
.env.local
.procoder_secrets
config/*.secret.exs
config/app_config/env_configs/*.secret.exs

# Native (Rustler / NIFs)
/native/*/target/
**/*.so
**/*.dll
**/*.dylib

# Diagnostic & Temporary Task Files
ast_output.txt
structural_analysis.txt
procoder_compiled_codebase.txt
compiled_codebase.txt
repro_*.exs
reproduce_*.exs
test_*.exs
gemini_test.exs

# System & OS
.DS_Store
Thumbs.db
